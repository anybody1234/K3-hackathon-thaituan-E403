DISCORD_BOT_TOKEN=your_discord_bot_token_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Tên kênh Discord (bot tự tìm theo tên)
SOURCE_CHANNEL_NAME=chia-sẻ
DIGEST_CHANNEL_NAME=tóm-tắt-chia-sẻ

# Danh sách tag cho phép
ALLOWED_TAGS=AI,Web,Backend,Data,DevOps,Mobile,Design,Career,Python,LLM,Prompt,Product

# Mapping tên tag → tên role trên server (JSON)
TOPIC_ROLE_MAP={"AI":"AI","Web":"Web","Backend":"Backend","Data":"Data"}

# Gemini model
GEMINI_MODEL=gemini-2.0-flash-lite
EMBEDDING_MODEL=models/text-embedding-004
